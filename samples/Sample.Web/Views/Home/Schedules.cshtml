@model IEnumerable<MediasiteUtil.Models.Schedule>
@{
    ViewData["Title"] = "Mediasite Schedules";
}

<h1 class="display-4">Mediasite Schedules</h1>

@foreach (var schedule in @Model)
{
    <p><b><a href="/Home/Recurrences?scheduleId=@schedule.Id">@schedule.Name</a></b> - @schedule.RecorderName - @schedule.Description</p>
}
